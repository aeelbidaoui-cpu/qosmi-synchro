{%- comment -%}
  Page 404 Qosmi (demande d'Amine du 09/11/2026) : la mascotte Mimi, une phrase sympa, et deux sorties (tous les parfums, recherche).
  Mimi est dessinée en SVG, dans le même trait que le logo (flacon arrondi, bouchon rond), ici l'air surprise.
{%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}
<section class="qk-section qk-404">
  <div class="qk-largeur qk-404__boite">
    <svg class="qk-404__mimi" viewBox="0 0 64 64" role="img" aria-label="{% if qk_nl %}Mimi, de mascotte van Qosmi, kijkt verbaasd{% else %}Mimi, la mascotte Qosmi, l'air surprise{% endif %}">
      <g transform="translate(9,7)" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="20" cy="8" r="6"/>
        <rect x="15" y="14" width="10" height="5" rx="1.5"/>
        <rect x="5" y="19" width="30" height="27" rx="10"/>
        <circle cx="14" cy="30" r="1.6" fill="currentColor"/>
        <circle cx="26" cy="30" r="1.6" fill="currentColor"/>
        <circle cx="20" cy="38" r="2.4"/>
        <path class="qk-404__q" d="M40 6 q0 -4 4 -4 q4 0 4 4 q0 3 -4 4 v3"/>
        <circle class="qk-404__q" cx="44" cy="17.5" r="0.6" fill="currentColor"/>
      </g>
    </svg>
    <p class="qk-404__code">404</p>
    <h1 class="qk-404__titre">{% if qk_nl %}Oeps, hier staat geen parfum.{% else %}Oups, pas de parfum ici.{% endif %}</h1>
    <p class="qk-404__texte">
      {%- if qk_nl -%}
        Mimi heeft overal gezocht, maar deze pagina is vervlogen. Gelukkig zijn onze parfums nog wel allemaal hier.
      {%- else -%}
        Mimi a cherché partout, mais cette page s'est évaporée. Heureusement, tous nos parfums sont encore là.
      {%- endif -%}
    </p>
    <div class="qk-404__actions">
      <a class="qk-404__bouton" href="{{ routes.collections_url }}/parfums">{% if qk_nl %}Alle parfums bekijken{% else %}Voir tous les parfums{% endif %}</a>
      <a class="qk-lien" href="{{ routes.search_url }}">{% if qk_nl %}Een parfum zoeken{% else %}Rechercher un parfum{% endif %}</a>
    </div>
  </div>
</section>
<style>
  .qk-404 { padding: clamp(56px, 10vw, 120px) 0; }
  .qk-404__boite { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; }
  .qk-404__mimi { width: clamp(120px, 18vw, 170px); height: auto; color: #111; animation: qk-mimi 3.2s ease-in-out infinite; }
  .qk-404__code { margin: 6px 0 0; font-size: 13px; letter-spacing: .3em; color: #6b6b6b; font-weight: 500; }
  .qk-404__titre { margin: 0; font-size: clamp(30px, 5vw, 52px); text-transform: uppercase; font-weight: 500; letter-spacing: .01em; line-height: 1.05; text-wrap: balance; }
  .qk-404__texte { margin: 4px 0 10px; max-width: 34em; font-size: 17px; line-height: 1.55; color: #3d3d3d; }
  .qk-404__actions { display: flex; flex-wrap: wrap; gap: 14px 26px; align-items: center; justify-content: center; }
  .qk-404__bouton { display: inline-block; background: #111; color: #fff; text-decoration: none; padding: 14px 26px;
    font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 500; }
  .qk-404__bouton:hover, .qk-404__bouton:focus-visible { background: #333; }
  @keyframes qk-mimi { 0%, 100% { transform: translateY(0) rotate(-4deg); } 50% { transform: translateY(-8px) rotate(4deg); } }
  @media (prefers-reduced-motion: reduce) { .qk-404__mimi { animation: none; } }
</style>

{% schema %}
{ "name": "Qosmi – page 404", "settings": [] }
{% endschema %}
