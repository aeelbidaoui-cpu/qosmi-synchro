{%- comment -%}
  Quiz « Trouve ton parfum » (12/11/2026, demande d'Amine) : 7 questions, une par écran, puis le parfum idéal et 5 autres.
  Le score s'appuie sur les odeurs de chaque parfum (assets/qk-odeurs.js), le prix et la disponibilité sont lus en direct.
{%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}
{%- assign qk_racine = routes.root_url | append: '/' | replace: '//', '/' -%}
<section class="qk-section qk-quiz" data-qk-quiz>
  <div class="qk-largeur qk-quiz__cadre">
    <div class="qk-quiz__entete" data-qk-q-entete hidden>
      <p class="qk-surtitre">{% if qk_nl %}Parfumquiz{% else %}Quiz parfum{% endif %}</p>
      <div class="qk-quiz__progres" aria-hidden="true"><span data-qk-q-barre></span></div>
    </div>
    <div data-qk-q-ecran aria-live="polite"></div>
    {%- comment -%} 13/11/2026 : « Reçois ta sélection par e-mail ». Le client devient contact avec les étiquettes quiz-pret, langue:fr|nl
      et quiz:<AAAAMMJJHHMM>:<rang>:<fiche> ; Shopify Flow lui envoie l'e-mail (config/mails/quiz_selection_*.liquid). {%- endcomment -%}
    <div class="qk-alerte qk-quiz__mail" data-qk-q-mail hidden>
      <div class="qk-alerte__ok" data-qk-q-mail-ok hidden>
        <strong>{% if qk_nl %}Verstuurd!{% else %}C'est envoyé !{% endif %}</strong>
        {% if qk_nl %}Je selectie komt binnen enkele minuten in je mailbox.{% else %}Ta sélection arrive dans ta boîte mail d'ici quelques minutes.{% endif %}
      </div>
      {%- form 'customer', class: 'qk-alerte__form', data-qk-q-mail-form: '' -%}
        <p class="qk-alerte__titre">{% if qk_nl %}Ontvang je selectie per e-mail{% else %}Reçois ta sélection par e-mail{% endif %}</p>
        <input type="hidden" name="contact[tags]" value="" data-qk-q-mail-tags>
        <input type="hidden" name="return_to" value="{{ request.path }}?quiz=ok">
        <div class="qk-alerte__ligne">
          <label class="visually-hidden" for="qk-quiz-email">{% if qk_nl %}E-mailadres{% else %}Adresse e-mail{% endif %}</label>
          <input id="qk-quiz-email" type="email" name="contact[email]" required autocomplete="email" placeholder="{% if qk_nl %}Je e-mailadres{% else %}Ton e-mail{% endif %}">
          <button type="submit" class="qk-alerte__bouton">{% if qk_nl %}Versturen{% else %}Envoyer{% endif %}</button>
        </div>
        <p class="qk-alerte__note">{% if qk_nl %}Je ontvangt ook onze maandelijkse nieuwsbrief (uitschrijven met één klik).{% else %}Tu recevras aussi notre e-mail mensuel (désinscription en un clic).{% endif %}</p>
      {%- endform -%}
    </div>
    <div class="qk-quiz__bas">
      <button type="button" class="qk-quiz__retour" data-qk-q-retour hidden>{% if qk_nl %}← Terug{% else %}← Retour{% endif %}</button>
      <button type="button" class="qk-acheter qk-quiz__suivant" data-qk-q-suivant hidden>{% if qk_nl %}Volgende{% else %}Suivant{% endif %}</button>
    </div>
  </div>
  <script src="{{ 'qk-odeurs.js' | asset_url }}" defer></script>
  <script src="{{ 'qk-odeurs-outils.js' | asset_url }}" defer></script>
  <script>
    (function () {
      var nl = {{ qk_nl | json }}, racine = {{ qk_racine | json }};
      function T(fr, n) { return nl ? n : fr.replace(/ ([?!:;])/g, '\u00a0$1'); }  /* espace insécable avant ? ! : ; */
      /* odeurs : id → poids. Les « tout_… » couvrent toute une famille. */
      var Q = [
        { id: 'pour', titre: T('C\'est pour qui ?', 'Voor wie is het?'), choix: [
          { id: 'femme', svg: 'femme', t: T('Pour elle', 'Voor haar') }, { id: 'homme', svg: 'homme', t: T('Pour lui', 'Voor hem') },
          { id: 'tous', svg: 'tous', t: T('Peu importe', 'Maakt niet uit'), s: T('Parfums mixtes compris', 'Ook unisex') }] },
        { id: 'quand', titre: T('Tu le porteras surtout…', 'Je draagt hem vooral…'), choix: [
          { id: 'jour', img: '1601276174812-63280a55656e', t: T('Tous les jours', 'Elke dag'), s: T('Léger, facile à porter', 'Licht, makkelijk'), w: { tout_agrumes: 1, tout_frais: 1, musc: 0.5, oud: -1, tabac: -0.5 } },
          { id: 'travail', img: '1611269154421-4e27233ac5c7', t: T('Au travail', 'Op het werk'), s: T('Propre, discret', 'Fris, discreet'), w: { musc: 1, iris: 0.5, tout_frais: 0.5, tout_agrumes: 0.5, the: 0.5, oud: -1.5, tout_gourmand: -1 } },
          { id: 'soir', img: '1580895456895-cfdf02e4c23f', t: T('Le soir, en sortie', '\'s Avonds, uitgaan'), s: T('Qui se remarque', 'Dat opvalt'), w: { tout_ambre: 1, oud: 1, tout_gourmand: 0.5, cuir: 0.5, tabac: 0.5, tout_agrumes: -0.5 } },
          { id: 'special', img: '1580657274234-7339717f4541', t: T('Pour les grandes occasions', 'Voor speciale momenten'), s: T('Chic et intense', 'Chic en intens'), w: { oud: 0.5, ambre: 0.5, rose: 0.5, safran: 0.5, encens: 0.5, tout_bois: 0.5 } }] },
        { id: 'saison', titre: T('Plutôt pour quelle saison ?', 'Voor welk seizoen?'), choix: [
          { id: 'ete', img: '1507525428034-b723cf961d3e', t: T('Printemps et été', 'Lente en zomer'), w: { tout_agrumes: 1, marin: 1, tout_frais: 1, tout_fruits: 0.5, tout_gourmand: -0.5, oud: -0.5 } },
          { id: 'hiver', img: '1551582045-6ec9c11d8697', t: T('Automne et hiver', 'Herfst en winter'), w: { tout_ambre: 1, tout_gourmand: 1, tout_epices: 1, tout_bois: 0.5, marin: -1 } },
          { id: 'annee', img: '1613408181923-f058a1b0e00c', t: T('Toute l\'année', 'Het hele jaar'), w: {} }] },
        { id: 'univers', multi: 2, titre: T('Quel univers te ressemble ?', 'Welke stijl past bij jou?'), aide: T('Choisis-en 1 ou 2.', 'Kies er 1 of 2.'), choix: [
          { id: 'frais', img: '1568569350062-ebfa3cb195df', t: T('Frais et propre', 'Fris en clean'), s: T('Agrumes, marin, thé', 'Citrus, zee, thee'), w: { tout_agrumes: 2, marin: 2, vert: 1.5, the: 1, menthe: 1, lavande: 1, tout_frais: 1 } },
          { id: 'gourmand', img: '1547414368-ac947d00b91d', t: T('Sucré et gourmand', 'Zoet en gourmand'), s: T('Vanille, caramel, tonka', 'Vanille, karamel, tonka'), w: { vanille: 2, caramel: 2, tonka: 1.5, tout_gourmand: 1, chocolat: 1, cafe: 1, amande: 1, lait: 1, coco: 1 } },
          { id: 'fleuri', img: '1582794543139-8ac9cb0f7b11', t: T('Fleuri', 'Bloemig'), s: T('Rose, jasmin, fleurs blanches', 'Roos, jasmijn, witte bloemen'), w: { tout_fleurs: 1.5, rose: 1.5, jasmin: 1.5, fleurs_blanches: 1.5, fleur_oranger: 1, iris: 1, pivoine: 1, muguet: 1 } },
          { id: 'boise', img: '1477862096227-3a1bb3b08330', t: T('Boisé et élégant', 'Houtig en elegant'), s: T('Santal, cèdre, vétiver', 'Sandelhout, ceder, vetiver'), w: { tout_bois: 1.5, santal: 2, cedre: 1.5, vetiver: 1.5, patchouli: 1, mousse: 1 } },
          { id: 'oriental', img: '1583182363039-59eac8609ab2', t: T('Oriental et intense', 'Oosters en intens'), s: T('Oud, ambre, encens, épices', 'Oud, amber, wierook, kruiden'), w: { oud: 2, ambre: 2, encens: 1.5, tout_epices: 1.5, safran: 1.5, cuir: 1, tabac: 1, baumes: 1, tout_ambre: 1 } },
          { id: 'fruite', img: '1613082410785-22292e8426e7', t: T('Fruité', 'Fruitig'), s: T('Fruits rouges, pêche, pomme', 'Rood fruit, perzik, appel'), w: { tout_fruits: 2, fruits_rouges: 1.5, peche: 1, pomme: 1, poire: 1, tropical: 1, cassis: 1 } }] },
        { id: 'adore', odeurs: true, multi: 3, titre: T('Les odeurs que tu adores ?', 'Geuren waar je dol op bent?'), aide: T('Jusqu\'à 3. Facultatif.', 'Tot 3. Optioneel.') },
        { id: 'deteste', odeurs: true, multi: 5, titre: T('Les odeurs que tu ne supportes pas ?', 'Geuren die je niet verdraagt?'), aide: T('On les écartera. Facultatif.', 'Die laten we weg. Optioneel.') },
        { id: 'budget', titre: T('Ton budget ?', 'Je budget?'), choix: [
          { id: 'b40', t: T('Moins de 40 €', 'Minder dan € 40'), max: 4000 }, { id: 'b70', t: '40 – 70 €', min: 4000, max: 7000 },
          { id: 'b120', t: '70 – 120 €', min: 7000, max: 12000 }, { id: 'tout', t: T('Pas de limite', 'Geen limiet') }] }
      ];
      var POPULAIRES = ['vanille', 'rose', 'oud', 'citron', 'cafe', 'lavande', 'musc', 'cuir', 'coco', 'jasmin', 'santal', 'caramel', 'fruits_rouges', 'ambre', 'marin', 'tabac', 'patchouli', 'iris', 'cannelle', 'the'];
      var rep = {}, etape = 0, ecran = document.querySelector('[data-qk-q-ecran]');
      var bRetour = document.querySelector('[data-qk-q-retour]'), bSuiv = document.querySelector('[data-qk-q-suivant]');

      function el(tag, cls, txt) { var e = document.createElement(tag); if (cls) e.className = cls; if (txt != null) e.textContent = txt; return e; }
      function barre() { document.querySelector('[data-qk-q-barre]').style.width = Math.round(100 * Math.min(etape, Q.length) / Q.length) + '%'; }

      var IMG = 'https://images.unsplash.com/photo-', TAILLE = '?auto=format&fit=crop&w=700&h=875&q=75';  /* photos Unsplash (licence libre) */
      var accueilVu = false, dernier = -1;
      /* remonter en haut du quiz dans le bon conteneur (le thème fait défiler .page-wrapper, pas la fenêtre :
         window.scrollTo décalait toute la page et laissait une bande blanche en bas) */
      function remonter() {
        var sec = document.querySelector('[data-qk-quiz]'), top = sec.getBoundingClientRect().top;
        if (top >= 0) return;
        var c = sec.parentElement;
        while (c && c !== document.body) { var o = getComputedStyle(c).overflowY; if ((o === 'auto' || o === 'scroll') && c.scrollHeight > c.clientHeight) break; c = c.parentElement; }
        if (c && c !== document.body) c.scrollBy({ top: top - 20, behavior: 'smooth' });
        else window.scrollBy({ top: top - 20, behavior: 'smooth' });
      }
      /* icônes de flacons (question 1) : dessins au trait, aucune photo de personne */
      var ELLE = '<circle cx="48" cy="13" r="6"/><path d="M43 19h10v8H43z"/><path d="M48 27c-15 0-23 11-23 27 0 17 9 31 23 31s23-14 23-31c0-16-8-27-23-27z"/><path d="M34 47c-3 8-2 17 3 24"/>';
      var LUI = '<rect x="39" y="8" width="18" height="12" rx="1.5"/><path d="M43 20h10v8H43z"/><rect x="25" y="28" width="46" height="57" rx="5"/><path d="M33 47h30M33 67h30"/>';
      var SVG = {
        femme: '<svg viewBox="0 0 96 96" aria-hidden="true">' + ELLE + '</svg>',
        homme: '<svg viewBox="0 0 96 96" aria-hidden="true">' + LUI + '</svg>',
        tous: '<svg viewBox="0 0 96 96" aria-hidden="true"><g transform="translate(-6 14) scale(.72)">' + ELLE + '</g><g transform="translate(37 14) scale(.72)">' + LUI + '</g></svg>'
      };
      function accueil() {
        document.querySelector('[data-qk-q-entete]').hidden = true; bRetour.hidden = true; bSuiv.hidden = true;
        ecran.innerHTML = '';
        var h = el('div', 'qk-quiz__accueil qk-quiz__entree');
        h.style.backgroundImage = 'url(' + IMG + '1778318422619-dc39983cb454?auto=format&fit=crop&w=1600&h=900&q=75)';
        var t = el('div', 'qk-quiz__accueil-texte');
        t.appendChild(el('p', 'qk-quiz__accueil-sur', T('1 minute · 7 questions', '1 minuut · 7 vragen')));
        t.appendChild(el('h1', 'qk-quiz__accueil-titre', T('Trouve le parfum qui te ressemble', 'Vind de parfum die bij je past')));
        t.appendChild(el('p', 'qk-quiz__accueil-sous', T('Dis-nous ce que tu aimes, on choisit pour toi parmi nos parfums.', 'Vertel ons wat je mooi vindt, wij kiezen voor jou uit onze parfums.')));
        var go = el('button', 'qk-quiz__go', T('Commencer', 'Starten')); go.type = 'button';
        go.addEventListener('click', function () { accueilVu = true; document.querySelector('[data-qk-q-entete]').hidden = false; afficher(); });
        t.appendChild(go); h.appendChild(t); ecran.appendChild(h);
      }
      function afficher() {
        if (!accueilVu) return accueil();
        barre();
        if (etape >= Q.length) return resultat();
        var q = Q[etape], O = window.qkOdeurs;
        ecran.innerHTML = '';
        var nouvelle = dernier !== etape;
        if (nouvelle) { ecran.className = ''; void ecran.offsetWidth; ecran.className = 'qk-quiz__entree'; }
        ecran.appendChild(el('p', 'qk-quiz__num', (etape + 1) + ' / ' + Q.length));
        ecran.appendChild(el('h1', 'qk-quiz__question', q.titre));
        if (q.aide) ecran.appendChild(el('p', 'qk-quiz__aide', q.aide));
        var photos = !q.odeurs && q.choix.some(function (c) { return c.img || c.svg; });
        var grille = el('div', q.odeurs ? 'qk-odeurs__puces qk-quiz__puces' : 'qk-quiz__choix' + (photos ? ' qk-quiz__choix--photos' : ''));
        if (!q.odeurs) grille.style.setProperty('--qk-cols', q.choix.length > 4 ? 3 : q.choix.length);
        var liste = q.odeurs ? POPULAIRES.map(function (id) { var o = O.parId[id]; return { id: id, t: nl ? o.nl : o.fr }; }) : q.choix;
        var sel = [].concat(rep[q.id] || []);
        liste.forEach(function (c) {
          var b = el('button', q.odeurs ? 'qk-odeurs__puce' : 'qk-quiz__carte');
          b.type = 'button'; b.setAttribute('aria-pressed', sel.indexOf(c.id) >= 0 ? 'true' : 'false');
          if (sel.indexOf(c.id) >= 0) b.classList.add('is-on');
          if (q.odeurs) b.textContent = c.t;
          else {
            if (c.svg) {
              var ic = el('span', 'qk-quiz__icone'); ic.innerHTML = SVG[c.svg];
              b.appendChild(ic); b.classList.add('qk-quiz__carte--icone');
            }
            if (c.img) {
              var im = el('img', 'qk-quiz__photo'); im.alt = ''; im.loading = 'lazy'; im.src = IMG + c.img + TAILLE;
              b.appendChild(im); b.classList.add('qk-quiz__carte--photo');
            }
            var tx = el('span', 'qk-quiz__texte'); tx.appendChild(el('span', 'qk-quiz__titre', c.t)); if (c.s) tx.appendChild(el('span', 'qk-quiz__sous', c.s));
            b.appendChild(tx);
            b.appendChild(el('span', 'qk-quiz__coche', '✓'));
          }
          if (nouvelle) b.style.animationDelay = (liste.indexOf(c) * 60) + 'ms'; else b.style.animation = 'none';
          b.addEventListener('click', function () {
            if (q.multi) {
              var k = sel.indexOf(c.id);
              if (k >= 0) sel.splice(k, 1); else { if (sel.length >= q.multi) sel.shift(); sel.push(c.id); }
              rep[q.id] = sel.slice(); afficher();
              if (sel.length >= q.multi) setTimeout(function () { if (Q[etape] === q) { etape++; afficher(); } }, 450);
            } else { rep[q.id] = sel.indexOf(c.id) >= 0 && q.odeurs ? [] : [c.id]; etape++; afficher(); }
          });
          grille.appendChild(b);
        });
        ecran.appendChild(grille);
        if (q.odeurs) {
          var passer = el('button', 'qk-quiz__passer', T('Pas d\'idée, on passe', 'Geen idee, verder'));
          passer.type = 'button';
          passer.addEventListener('click', function () { rep[q.id] = []; etape++; afficher(); });
          ecran.appendChild(passer);
        }
        (Q[etape + 1] && Q[etape + 1].choix || []).forEach(function (c) { if (c.img) { var pre = new Image(); pre.src = IMG + c.img + TAILLE; } });
        bRetour.hidden = false;
        bSuiv.hidden = !q.multi; bSuiv.disabled = !(rep[q.id] || []).length;
        if (dernier !== etape) { dernier = etape; remonter(); }
      }

      function scores() {
        var O = window.qkOdeurs, W = {};
        function ajoute(w) { Object.keys(w || {}).forEach(function (id) { if (O.parId[id]) W[O.parId[id].i] = (W[O.parId[id].i] || 0) + w[id]; }); }
        Q.forEach(function (q) { (rep[q.id] || []).forEach(function (c) { var x = (q.choix || []).filter(function (y) { return y.id === c; })[0]; if (x) ajoute(x.w); }); });
        (rep.adore || []).forEach(function (id) { var w = {}; w[id] = 3; ajoute(w); });
        var non = (rep.deteste || []).map(function (id) { return O.parId[id].i; });
        var pour = (rep.pour || [])[0], res = [];
        Object.keys(O.profils).forEach(function (h) {
          if (/coffret|gel-douche|deodorant|lotion|creme|savon|bougie/.test(h)) return;
          if (pour === 'femme' && h.indexOf('pour-homme') >= 0) return;
          if (pour === 'homme' && h.indexOf('pour-femme') >= 0) return;
          var p = O.profils[h], s = 0, eus = [];
          if (non.some(function (i) { return p.toutes.indexOf(i) >= 0; })) return;
          p.toutes.forEach(function (i) {
            if (!W[i]) return;
            s += W[i] * (p.cles.indexOf(i) >= 0 ? 1.5 : 1);
            if (W[i] > 0 && !O.odeurs[i].tout) eus.push(i);
          });
          if (s > 0) res.push({ h: h, s: s / Math.sqrt(Math.max(4, p.toutes.length)), eus: eus.sort(function (a, b) { return (W[b] || 0) - (W[a] || 0); }) });
        });
        res.sort(function (a, b) { return b.s - a.s; });
        return O.unique(res);
      }

      function resultat() {
        var O = window.qkOdeurs, b = (rep.budget || [])[0], bud = Q[6].choix.filter(function (c) { return c.id === b; })[0] || {};
        bRetour.hidden = true; bSuiv.hidden = true;
        ecran.innerHTML = '';
        ecran.appendChild(el('h1', 'qk-quiz__question', T('On a trouvé ton parfum', 'We hebben je parfum gevonden')));
        var une = el('div', 'qk-quiz__une'), autres = el('div', 'qk-odeurs__grille qk-quiz__autres');
        var attente = el('p', 'qk-quiz__aide', T('On cherche dans nos parfums…', 'We zoeken in onze parfums…'));
        ecran.appendChild(attente); ecran.appendChild(une);
        var t2 = el('h2', 'qk-odeurs__titre-res', T('Ils pourraient aussi te plaire', 'Deze vind je misschien ook mooi'));
        var liste = scores();
        var filtre = function (p) { return (!bud.min || p.price_min >= bud.min) && (!bud.max || p.price_min <= bud.max); };
        O.remplir(une, liste, 0, 5, nl, 0, filtre).then(function () {
          attente.remove();
          var cartes = Array.prototype.slice.call(une.children);
          if (!cartes.length) { une.appendChild(el('p', 'qk-quiz__aide', T('Aucun parfum en stock ne correspond. Essaie un autre budget ou une autre odeur.', 'Geen parfum op voorraad gevonden. Probeer een ander budget of een andere geur.'))); }
          cartes.slice(1).forEach(function (c) { autres.appendChild(c); });
          if (cartes[0]) {
            cartes[0].insertBefore(el('span', 'qk-quiz__badge', T('Ton parfum idéal', 'Jouw ideale parfum')), cartes[0].children[1]);
            cartes[0].appendChild(el('span', 'qk-acheter qk-quiz__cta', T('Découvrir ce parfum', 'Ontdek deze parfum')));
          }
          if (autres.children.length) { ecran.appendChild(t2); ecran.appendChild(autres); }
          var actions = el('div', 'qk-quiz__actions');
          var refaire = el('button', 'qk-acheter', T('Refaire le quiz', 'Quiz opnieuw doen')); refaire.type = 'button';
          refaire.addEventListener('click', function () { rep = {}; etape = 0; document.querySelector('[data-qk-q-entete]').hidden = false; afficher(); });
          var ids = []; (rep.adore || []).forEach(function (x) { ids.push(x); });
          liste.slice(0, 1).forEach(function (r) { r.eus.slice(0, 3 - ids.length).forEach(function (i) { if (ids.indexOf(O.odeurs[i].id) < 0) ids.push(O.odeurs[i].id); }); });
          var affiner = el('a', 'qk-lien', T('Affiner par odeurs', 'Verfijnen op geur'));
          affiner.href = racine + 'pages/odeurs' + (ids.length ? '?o=' + ids.slice(0, 3).join(',') : '');
          actions.appendChild(refaire); actions.appendChild(affiner); ecran.appendChild(actions);
          /* sélection par e-mail : fiches des cartes affichées, dans l'ordre */
          var mail = document.querySelector('[data-qk-q-mail]');
          var fiches = Array.prototype.slice.call(une.querySelectorAll('a.qk-carte')).concat(Array.prototype.slice.call(autres.querySelectorAll('a.qk-carte')))
            .map(function (a) { var m = a.getAttribute('href').match(/\/products\/([^/?#]+)/); return m ? m[1] : null; }).filter(Boolean).slice(0, 5);
          if (mail && fiches.length) {
            var d = new Date(), z = function (n) { return ('0' + n).slice(-2); };
            var ts = '' + d.getFullYear() + z(d.getMonth() + 1) + z(d.getDate()) + z(d.getHours()) + z(d.getMinutes());
            mail.querySelector('[data-qk-q-mail-tags]').value = ['quiz-pret', 'langue:' + (nl ? 'nl' : 'fr')].concat(fiches.map(function (h, k) { return 'quiz:' + ts + ':' + (k + 1) + ':' + h; })).join(',');
            mail.querySelector('[data-qk-q-mail-form]').addEventListener('submit', function () { try { sessionStorage.setItem('qk-quiz-mail', '1'); } catch (e) {} });
            ecran.appendChild(mail); mail.hidden = false;
          }
          if (window.qkFavoris) qkFavoris.maj();
        });
      }

      bRetour.addEventListener('click', function () { if (etape > 0) { etape--; } else { accueilVu = false; } afficher(); });
      bSuiv.addEventListener('click', function () { etape++; afficher(); });
      /* retour du formulaire « sélection par e-mail » (?quiz=ok, ou repli si la vérification anti-robot a perdu le paramètre) */
      (function () {
        var vu = /[?&]quiz=ok/.test(location.search) || /[?&]customer_posted=true/.test(location.search);
        try { if (sessionStorage.getItem('qk-quiz-mail')) { vu = vu || document.referrer.indexOf('/challenge') >= 0 || /customer_posted/.test(location.search); } } catch (e) {}
        if (!vu) return;
        try { sessionStorage.removeItem('qk-quiz-mail'); } catch (e) {}
        var m = document.querySelector('[data-qk-q-mail]');
        m.hidden = false; m.querySelector('[data-qk-q-mail-ok]').hidden = false; m.querySelector('[data-qk-q-mail-form]').hidden = true;
        m.parentNode.insertBefore(m, m.parentNode.firstChild);
      })();
      function demarrer() { if (window.qkOdeurs && !ecran.children.length) afficher(); }
      if (window.qkOdeurs) demarrer(); else document.addEventListener('qk:odeurs', demarrer);
    })();
  </script>
</section>

