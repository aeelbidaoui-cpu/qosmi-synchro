  {%- if qk_nl -%}<script type="application/ld+json">{"@context": "https://schema.org", "@type": "DefinedTermSet", "name": "Geurwoordenboek Qosmi", "hasDefinedTerm": [{"@type": "DefinedTerm", "name": "Bergamot", "description": "Citrusvrucht die vooral in Calabrië (Zuid-Italië) groeit. Uit de schil perst men een frisse, licht bittere en bloemige olie. Ze opent heel veel parfums, van colognes tot houtgeuren."}, {"@type": "DefinedTerm", "name": "Citroen", "description": "Levendige, sprankelende schil die meteen een propere indruk geeft. Veel gebruikt in frisse geuren en zomerparfums. Hij vervliegt snel en is vooral een topnoot."}, {"@type": "DefinedTerm", "name": "Mandarijn", "description": "Zachter en zoeter dan sinaasappel. Mandarijn geeft een sappige, ronde frisheid en zit zowel in herenparfums als in fruitig-bloemige geuren."}, {"@type": "DefinedTerm", "name": "Grapefruit", "description": "Zurige, licht bittere en heel opwekkende noot. Geeft pit aan frisse en sportieve parfums."}, {"@type": "DefinedTerm", "name": "Neroli", "description": "Olie uit de bloesems van de bittere sinaasappelboom. Fris, groen en stralend: het hart van de klassieke eau de cologne."}, {"@type": "DefinedTerm", "name": "Roos", "description": "De meest gebruikte bloem in de parfumerie. Damascusroos of centifolia: fris en poederig, fruitig of donker en kruidig, afhankelijk van wat ermee samengaat. Samen met oud vormt ze een akkoord dat in het Midden-Oosten erg geliefd is."}, {"@type": "DefinedTerm", "name": "Jasmijn", "description": "Rijke, zonnige witte bloem, zoet en een tikje dierlijk. Jasmijn grandiflorum en sambac geven veel damesparfums body en sensualiteit."}, {"@type": "DefinedTerm", "name": "Oranjebloesem", "description": "Stralende witte bloem, honingachtig en geruststellend. Zachter en bloemiger dan neroli, dat van dezelfde boom komt."}, {"@type": "DefinedTerm", "name": "Iris", "description": "Men gebruikt de wortel van de iris, die jarenlang droogt. Die geeft een poederige, elegante geur die doet denken aan make-up en verse aarde. Een van de duurste grondstoffen."}, {"@type": "DefinedTerm", "name": "Tuberoos", "description": "Weelderige witte bloem, romig en bedwelmend. Ze tekent de grote, intense bloemengeuren en valt meteen op."}, {"@type": "DefinedTerm", "name": "Ylang-ylang", "description": "Gele bloem uit de Comoren en Madagaskar, zonnig en romig met een licht fruitig kantje. Ze maakt bloemenboeketten ronder en warmer."}, {"@type": "DefinedTerm", "name": "Lelietje-van-dalen", "description": "Frisse, groene lentebloem. De geur is niet te extraheren en wordt door parfumeurs nagemaakt met andere grondstoffen."}, {"@type": "DefinedTerm", "name": "Viooltje", "description": "Poederige, zachte en soms zoete noot. Het blad van het viooltje geeft dan weer een groene, licht waterige frisheid."}, {"@type": "DefinedTerm", "name": "Saffraan", "description": "Kostbare specerij met een leerachtige, honingzoete en licht metalige geur. Veel gebruikt in oosterse parfums en samen met oud."}, {"@type": "DefinedTerm", "name": "Kardemom", "description": "Frisse, aromatische specerij, bijna muntachtig. Ze geeft houtige en amberige parfums licht zonder ze zwaar te maken."}, {"@type": "DefinedTerm", "name": "Kaneel", "description": "Warme, zoete specerij die doet denken aan gebak en de feestdagen. Vaak in winterparfums."}, {"@type": "DefinedTerm", "name": "Peper", "description": "Zwarte peper, roze peper of roze bessen: een pikante, sprankelende noot die meteen reliëf geeft."}, {"@type": "DefinedTerm", "name": "Gember", "description": "Kruidige, frisse en licht citroenachtige noot. Ze geeft energie aan frisse parfums en houtgeuren."}, {"@type": "DefinedTerm", "name": "Oud", "description": "Ook agarhout genoemd. Een hars die ontstaat in de kern van de aquilariaboom wanneer die geïnfecteerd raakt. De geur is diep, houtig, leerachtig en soms dierlijk. Erg kostbaar en in parfums vaak deels nagemaakt."}, {"@type": "DefinedTerm", "name": "Sandelhout", "description": "Romig, zacht en melkachtig hout uit India of Australië. Het geeft een warme, omhullende basis."}, {"@type": "DefinedTerm", "name": "Ceder", "description": "Droog, zuiver hout dat doet denken aan een geslepen potlood. Het geeft structuur aan de basis van veel heren- en unisexparfums."}, {"@type": "DefinedTerm", "name": "Vetiver", "description": "Wortel van een tropisch gras, vooral geteeld in Haïti en op Java. De geur is houtig, aards en soms rokerig, met een droge elegantie."}, {"@type": "DefinedTerm", "name": "Patchoeli", "description": "Bladeren van een Aziatische plant, gedroogd en gedistilleerd. Houtige, aardse en licht kamferachtige noot, onmisbaar in chypres en veel moderne parfums."}, {"@type": "DefinedTerm", "name": "Eikenmos", "description": "Korstmos dat op eiken groeit. Vochtige, houtige en licht zilte geur: het handelsmerk van chypreparfums. Het gebruik is vandaag gereglementeerd, parfumeurs passen het aan of maken het na."}, {"@type": "DefinedTerm", "name": "Vanille", "description": "Peul van een orchidee, vooral uit Madagaskar. Zacht, warm en troostend: vanille maakt parfums ronder en sensueler."}, {"@type": "DefinedTerm", "name": "Tonkaboon", "description": "Zaad uit Zuid-Amerika met tonen van amandel, hooi en karamel. Het geeft een warme, licht gourmande basis."}, {"@type": "DefinedTerm", "name": "Praliné", "description": "Gourmand akkoord van gekaramelliseerde hazelnoten of amandelen. Het geeft parfums een zoet, verslavend kantje."}, {"@type": "DefinedTerm", "name": "Koffie", "description": "Geroosterde, licht bittere noot die vanille- en houtakkoorden wakker maakt. Veel gebruikt in avondparfums."}, {"@type": "DefinedTerm", "name": "Amber", "description": "In de parfumerie is amber niet de steen: het is een warm, zacht en harsachtig akkoord, vaak met vanille, benzoë en labdanum. Het vormt de basis van oosterse of amberparfums."}, {"@type": "DefinedTerm", "name": "Ambergris en ambroxan", "description": "Ambergris is een zeldzame grondstof uit de zee, met een zilte, minerale en zachte geur. Vandaag gebruikt men vooral moleculen die het nabootsen, zoals ambroxan, met een houtig, stralend en heel blijvend effect."}, {"@type": "DefinedTerm", "name": "Wierook", "description": "Hars van de olibanumboom, al sinds de oudheid gebrand. De geur is rokerig, citroenachtig en een beetje mystiek."}, {"@type": "DefinedTerm", "name": "Benzoë en labdanum", "description": "Twee warme harsen. Benzoë is zacht en vanilleachtig; labdanum, uit de cistusroos, is donkerder, leerachtig en amberig."}, {"@type": "DefinedTerm", "name": "Muskus", "description": "Muskus is vandaag altijd synthetisch. Hij geeft een effect van propere, zachte huid en laat het parfum langer blijven."}, {"@type": "DefinedTerm", "name": "Leer", "description": "Akkoord dat doet denken aan gelooid leer, vaak gemaakt met berk, saffraan of rokerige noten. Het geeft karakter."}, {"@type": "DefinedTerm", "name": "Tabak", "description": "Gedroogde tabaksbladeren met een honingachtige, houtige en licht rokerige geur. Een warme noot, vaak in winterparfums."}, {"@type": "DefinedTerm", "name": "Lavendel", "description": "Plant uit de Provence, fris, aromatisch en zacht tegelijk. De basis van de fougères, de familie van de klassieke herenparfums."}, {"@type": "DefinedTerm", "name": "Munt", "description": "Frisse, levendige noot die een koel gevoel geeft. Ze maakt zomerparfums wakker."}, {"@type": "DefinedTerm", "name": "Zeenoten", "description": "Akkoorden die doen denken aan zeelucht, zout en water. Men spreekt ook van aquatische noten. Ze typeren frisse parfums sinds de jaren 1990."}, {"@type": "DefinedTerm", "name": "Thee", "description": "Groene, zwarte of matchathee: een transparante, licht bittere noot die rust en frisheid brengt."}, {"@type": "DefinedTerm", "name": "Top-, hart- en basisnoten", "description": "De drie fases van een parfum. Topnoten ruik je meteen en ze verdwijnen na enkele minuten. Hartnoten bepalen het karakter. Basisnoten zijn zwaarder en blijven uren op de huid."}, {"@type": "DefinedTerm", "name": "Geurpiramide", "description": "De manier om de noten van een parfum in drie lagen voor te stellen: top, hart en basis."}, {"@type": "DefinedTerm", "name": "Akkoord", "description": "Mengsel van meerdere grondstoffen dat een nieuwe geur vormt, zoals een akkoord in de muziek. Bijvoorbeeld het amberakkoord of het leerakkoord."}, {"@type": "DefinedTerm", "name": "Geurfamilie", "description": "Manier om parfums in te delen volgens hun belangrijkste geur: citrus, bloemig, fougère, chypre, houtig, amber (oosters), leer, gourmand…"}, {"@type": "DefinedTerm", "name": "Chypre", "description": "Familie gebouwd op het contrast tussen bergamot in de top en eikenmos, patchoeli en labdanum in de basis."}, {"@type": "DefinedTerm", "name": "Fougère", "description": "Familie uit het einde van de 19e eeuw: lavendel, geranium, eikenmos en coumarine (de geur van de tonkaboon). De grote klassieker bij herenparfums."}, {"@type": "DefinedTerm", "name": "Gourmand", "description": "Parfum met eetbare noten: vanille, karamel, chocolade, koffie, praliné… Een erg populaire familie sinds de jaren 1990."}, {"@type": "DefinedTerm", "name": "Eau de toilette, eau de parfum, extrait", "description": "De concentratie aan geurstoffen. Meestal is een eau de toilette lichter, een eau de parfum geconcentreerder en een parfum of extrait nog meer. Hoe lang een geur blijft, hangt ook af van de samenstelling en de huid."}, {"@type": "DefinedTerm", "name": "Houdbaarheid", "description": "Hoe lang je het parfum op je huid ruikt nadat je het gesprayd hebt."}, {"@type": "DefinedTerm", "name": "Sillage", "description": "Het geurspoor dat een parfum achterlaat als je beweegt. Een sterke sillage valt van ver op, een subtiele blijft dicht bij de huid."}, {"@type": "DefinedTerm", "name": "Flanker", "description": "Variant van een bestaand parfum dat de naam behoudt maar aanpast: Intense, Parfum, Eau Fraîche, zomereditie…"}, {"@type": "DefinedTerm", "name": "Nicheparfum", "description": "Parfum van een gespecialiseerd, vaak onafhankelijk huis, dat creativiteit en grondstoffen belangrijker vindt dan massadistributie."}, {"@type": "DefinedTerm", "name": "Neus", "description": "De bijnaam van de parfumeur, degene die de formule van een parfum samenstelt."}, {"@type": "DefinedTerm", "name": "Maceratie", "description": "De rusttijd van het parfum na het mengen en vóór het bottelen, zodat de grondstoffen goed samensmelten."}, {"@type": "DefinedTerm", "name": "Geurstrip", "description": "Dun strookje vloeipapier waarop je een parfum spuit om het te ruiken zonder het te dragen."}]}</script>{%- else -%}<script type="application/ld+json">{"@context": "https://schema.org", "@type": "DefinedTermSet", "name": "Lexique du parfum Qosmi", "hasDefinedTerm": [{"@type": "DefinedTerm", "name": "Bergamote", "description": "Agrume cultivé surtout en Calabre, dans le sud de l'Italie. On presse son zeste pour en tirer une essence fraîche, un peu amère et florale. Elle ouvre une grande partie des parfums, des colognes aux boisés."}, {"@type": "DefinedTerm", "name": "Citron", "description": "Zeste vif et pétillant qui donne un effet de propreté immédiat. Très présent dans les eaux fraîches et les parfums d'été, il s'évapore vite et sert surtout de note de tête."}, {"@type": "DefinedTerm", "name": "Mandarine", "description": "Plus douce et plus sucrée que l'orange, la mandarine apporte une fraîcheur juteuse et ronde. On la trouve aussi bien dans les parfums masculins que dans les floraux fruités."}, {"@type": "DefinedTerm", "name": "Pamplemousse", "description": "Note acidulée et légèrement amère, très tonique. Elle donne du peps aux parfums frais et sportifs."}, {"@type": "DefinedTerm", "name": "Néroli", "description": "Essence tirée des fleurs du bigaradier (l'oranger amer). Fraîche, verte et lumineuse, elle est au cœur des eaux de Cologne classiques."}, {"@type": "DefinedTerm", "name": "Rose", "description": "La fleur la plus utilisée en parfumerie. Rose de Damas ou rose centifolia, elle peut être fraîche et poudrée, fruitée ou sombre et épicée selon ce qui l'accompagne. Associée à l'oud, elle forme un accord très apprécié au Moyen-Orient."}, {"@type": "DefinedTerm", "name": "Jasmin", "description": "Fleur blanche riche et solaire, à la fois douce et un peu animale. Le jasmin grandiflorum et le jasmin sambac donnent du corps et de la sensualité à beaucoup de parfums féminins."}, {"@type": "DefinedTerm", "name": "Fleur d'oranger", "description": "Fleur blanche lumineuse, miellée et rassurante. Plus douce et plus florale que le néroli, issu du même arbre."}, {"@type": "DefinedTerm", "name": "Iris", "description": "On utilise la racine de l'iris, séchée pendant plusieurs années. Elle donne une odeur poudrée, élégante, qui rappelle le maquillage et la terre fraîche. C'est l'une des matières les plus chères."}, {"@type": "DefinedTerm", "name": "Tubéreuse", "description": "Fleur blanche opulente, crémeuse et capiteuse. Elle signe les grands floraux intenses et se remarque de loin."}, {"@type": "DefinedTerm", "name": "Ylang-ylang", "description": "Fleur jaune des Comores et de Madagascar, solaire et crémeuse, avec une facette légèrement fruitée. Elle arrondit et réchauffe les bouquets floraux."}, {"@type": "DefinedTerm", "name": "Muguet", "description": "Fleur printanière fraîche et verte. Impossible à extraire, son odeur est recréée par les parfumeurs à partir d'autres matières."}, {"@type": "DefinedTerm", "name": "Violette", "description": "Note poudrée et douce, parfois sucrée. La feuille de violette, elle, apporte une fraîcheur verte et légèrement aquatique."}, {"@type": "DefinedTerm", "name": "Safran", "description": "Épice précieuse au parfum cuiré, miellé et un peu métallique. Très présent dans les parfums orientaux et les accords avec l'oud."}, {"@type": "DefinedTerm", "name": "Cardamome", "description": "Épice fraîche et aromatique, presque mentholée. Elle éclaire les parfums boisés et ambrés sans les alourdir."}, {"@type": "DefinedTerm", "name": "Cannelle", "description": "Épice chaude et sucrée, qui évoque la pâtisserie et les fêtes de fin d'année. On la retrouve dans beaucoup de parfums d'hiver."}, {"@type": "DefinedTerm", "name": "Poivre", "description": "Poivre noir, poivre rose ou baies roses : une note piquante et pétillante qui donne du relief dès l'ouverture."}, {"@type": "DefinedTerm", "name": "Gingembre", "description": "Note épicée, fraîche et un peu citronnée. Elle apporte de l'énergie aux parfums frais comme aux boisés."}, {"@type": "DefinedTerm", "name": "Oud", "description": "Aussi appelé bois d'agar. Résine qui se forme dans le cœur de l'aquilaria quand l'arbre est infecté. Son odeur est profonde, boisée, cuirée et parfois animale. Très précieuse, elle est souvent reconstituée en partie en parfumerie."}, {"@type": "DefinedTerm", "name": "Santal", "description": "Bois crémeux, doux et lacté, originaire d'Inde ou d'Australie. Il donne une base chaude et enveloppante."}, {"@type": "DefinedTerm", "name": "Cèdre", "description": "Bois sec et net, qui évoque le crayon taillé. Il structure le fond de nombreux parfums masculins et mixtes."}, {"@type": "DefinedTerm", "name": "Vétiver", "description": "Racine d'une herbe tropicale, surtout cultivée à Haïti et à Java. Son odeur est boisée, terreuse et parfois fumée. Elle donne une élégance sèche."}, {"@type": "DefinedTerm", "name": "Patchouli", "description": "Feuilles d'une plante d'Asie, séchées puis distillées. Note boisée, terreuse et un peu camphrée, indispensable aux chyprés et à beaucoup de parfums modernes."}, {"@type": "DefinedTerm", "name": "Mousse de chêne", "description": "Lichen qui pousse sur les chênes. Odeur humide, boisée et un peu salée : c'est la signature des parfums chyprés. Son usage est aujourd'hui encadré, les parfumeurs l'adaptent ou la recréent."}, {"@type": "DefinedTerm", "name": "Vanille", "description": "Gousse d'une orchidée, surtout de Madagascar. Douce, chaude et réconfortante, la vanille arrondit les parfums et les rend plus sensuels."}, {"@type": "DefinedTerm", "name": "Fève tonka", "description": "Graine d'Amérique du Sud aux notes d'amande, de foin et de caramel. Elle donne un fond chaud et légèrement gourmand."}, {"@type": "DefinedTerm", "name": "Praline", "description": "Accord gourmand de noisettes ou d'amandes caramélisées. Il donne aux parfums un côté sucré et addictif."}, {"@type": "DefinedTerm", "name": "Café", "description": "Note torréfiée et un peu amère qui réveille les accords vanillés et boisés. Très utilisée dans les parfums de soirée."}, {"@type": "DefinedTerm", "name": "Ambre", "description": "En parfumerie, l'ambre n'est pas la pierre : c'est un accord chaud, doux et résineux, souvent fait de vanille, de benjoin et de labdanum. C'est la base des parfums dits orientaux ou ambrés."}, {"@type": "DefinedTerm", "name": "Ambre gris et ambroxan", "description": "L'ambre gris est une matière rare d'origine marine, à l'odeur salée, minérale et douce. Aujourd'hui, on utilise surtout des molécules qui la reproduisent, comme l'ambroxan, qui donne cet effet boisé, lumineux et très persistant."}, {"@type": "DefinedTerm", "name": "Encens", "description": "Résine d'oliban, brûlée depuis l'Antiquité. Son odeur est fumée, citronnée et un peu mystique."}, {"@type": "DefinedTerm", "name": "Benjoin et labdanum", "description": "Deux résines chaudes. Le benjoin est doux et vanillé ; le labdanum, tiré du ciste, est plus sombre, cuiré et ambré."}, {"@type": "DefinedTerm", "name": "Musc", "description": "Aujourd'hui toujours synthétique, le musc donne un effet de peau propre, doux et enveloppant. Il fixe le parfum et prolonge sa tenue."}, {"@type": "DefinedTerm", "name": "Cuir", "description": "Accord qui évoque le cuir tanné, souvent créé avec du bouleau, du safran ou des notes fumées. Il apporte du caractère."}, {"@type": "DefinedTerm", "name": "Tabac", "description": "Feuilles de tabac séchées, au parfum miellé, boisé et légèrement fumé. Une note chaude, très présente dans les parfums d'hiver."}, {"@type": "DefinedTerm", "name": "Lavande", "description": "Plante de Provence, à la fois fraîche, aromatique et douce. Elle est à la base des fougères, la famille des parfums masculins classiques."}, {"@type": "DefinedTerm", "name": "Menthe", "description": "Note fraîche et vive, qui donne une sensation de froid. Elle réveille les parfums d'été."}, {"@type": "DefinedTerm", "name": "Notes marines", "description": "Accords qui évoquent l'air de la mer, le sel et l'eau. On parle aussi de notes aquatiques. Elles ont marqué les parfums frais à partir des années 1990."}, {"@type": "DefinedTerm", "name": "Thé", "description": "Thé vert, noir ou matcha : une note transparente, légèrement amère, qui apporte calme et fraîcheur."}, {"@type": "DefinedTerm", "name": "Notes de tête, de cœur et de fond", "description": "Les trois temps d'un parfum. Les notes de tête se sentent tout de suite et partent en quelques minutes. Les notes de cœur forment le caractère du parfum. Les notes de fond, plus lourdes, restent des heures sur la peau."}, {"@type": "DefinedTerm", "name": "Pyramide olfactive", "description": "La manière de présenter les notes d'un parfum en trois étages : tête, cœur et fond."}, {"@type": "DefinedTerm", "name": "Accord", "description": "Mélange de plusieurs matières qui crée une odeur nouvelle, comme un accord de musique. Par exemple, l'accord ambré ou l'accord cuir."}, {"@type": "DefinedTerm", "name": "Famille olfactive", "description": "Manière de classer les parfums selon leur odeur dominante : hespéridé (agrumes), floral, fougère, chypré, boisé, ambré (oriental), cuir, gourmand…"}, {"@type": "DefinedTerm", "name": "Chypré", "description": "Famille construite sur le contraste entre la bergamote en tête et la mousse de chêne, le patchouli et le labdanum en fond."}, {"@type": "DefinedTerm", "name": "Fougère", "description": "Famille née à la fin du XIXe siècle : lavande, géranium, mousse de chêne et coumarine (l'odeur de la fève tonka). C'est le grand classique des parfums masculins."}, {"@type": "DefinedTerm", "name": "Gourmand", "description": "Parfum aux notes qui se mangent : vanille, caramel, chocolat, café, praliné… Une famille très populaire depuis les années 1990."}, {"@type": "DefinedTerm", "name": "Eau de toilette, eau de parfum, extrait", "description": "La concentration en essences. En général, une eau de toilette est plus légère, une eau de parfum plus concentrée, un parfum ou extrait encore plus. La tenue dépend aussi de la composition et de la peau."}, {"@type": "DefinedTerm", "name": "Tenue", "description": "Le temps pendant lequel on sent le parfum sur la peau après l'avoir vaporisé."}, {"@type": "DefinedTerm", "name": "Sillage", "description": "La trace odorante que le parfum laisse autour de soi quand on bouge. Un sillage fort se remarque de loin, un sillage discret reste proche de la peau."}, {"@type": "DefinedTerm", "name": "Flanker", "description": "Variante d'un parfum existant, qui garde son nom en l'adaptant : version Intense, Parfum, Eau Fraîche, édition d'été…"}, {"@type": "DefinedTerm", "name": "Parfum de niche", "description": "Parfum créé par une maison spécialisée, souvent indépendante, qui privilégie la création et les matières plutôt que la grande distribution."}, {"@type": "DefinedTerm", "name": "Nez", "description": "Le surnom du parfumeur créateur, celui qui compose la formule d'un parfum."}, {"@type": "DefinedTerm", "name": "Macération", "description": "Temps de repos du parfum après le mélange, avant la mise en flacon, pour que les matières se fondent entre elles."}, {"@type": "DefinedTerm", "name": "Mouillette", "description": "Fine bande de papier buvard sur laquelle on vaporise un parfum pour le sentir sans le porter."}]}</script>{%- endif -%}
  <script>
    (function () {
      var c = document.querySelector('[data-qk-lex-recherche]');
      if (!c) return;
      var norm = function (s) { return s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); };
      c.addEventListener('input', function () {
        var q = norm(c.value.trim());
        document.querySelectorAll('.qk-lex__item').forEach(function (d) { d.hidden = q && norm(d.textContent).indexOf(q) < 0; });
        document.querySelectorAll('.qk-lex__cat').forEach(function (h) {
          var e = h.nextElementSibling, vis = false;
          while (e && !e.classList.contains('qk-lex__cat')) { if (!e.hidden) vis = true; e = e.nextElementSibling; }
          h.hidden = !vis;
        });
      });
    })();
  </script>
</section>
