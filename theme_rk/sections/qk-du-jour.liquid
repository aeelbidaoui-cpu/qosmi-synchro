{%- comment -%}
  « Le parfum du jour » (demande d'Amine du 08/11/2026) : un grand parfum mis en avant chaque jour, avec un compte à rebours
  jusqu'au changement de parfum (minuit, heure de Bruxelles). Prix habituel, pas de remise.
  La liste des parfums possibles est le réglage « produits » (scripts/theme_rk.py, liste DU_JOUR) ; on garde ceux qui sont
  en ligne, en stock et avec une photo, et on en prend un par jour, à tour de rôle.
  Le parfum est choisi côté serveur (date UTC) puis recalé dans le navigateur sur la date de Bruxelles (page en cache).
{%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}
{%- comment -%} Le rang du jour se calcule sur la liste complète (stable même si un parfum sort de stock) ;
     s'il n'est pas disponible, on prend le suivant disponible. {%- endcomment -%}
{%- assign qk_total = section.settings.produits.size -%}
{%- assign qk_n = 0 -%}
{%- assign qk_premier = -1 -%}
{%- assign qk_choix = -1 -%}
{%- if qk_total > 0 -%}
  {%- assign qk_cible = 'now' | date: '%s' | divided_by: 86400 | modulo: qk_total -%}
  {%- for p in section.settings.produits -%}
    {%- if p.available and p.featured_image -%}
      {%- assign qk_n = qk_n | plus: 1 -%}
      {%- if qk_premier < 0 -%}{%- assign qk_premier = forloop.index0 -%}{%- endif -%}
      {%- if qk_choix < 0 and forloop.index0 >= qk_cible -%}{%- assign qk_choix = forloop.index0 -%}{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if qk_choix < 0 -%}{%- assign qk_choix = qk_premier -%}{%- endif -%}
{%- endif -%}
{%- if qk_n > 0 -%}
<section class="qk-section qk-dujour-section" id="qk-dujour-{{ section.id }}" data-qk-total="{{ qk_total }}">
  <div class="qk-largeur">
    <div class="qk-dujour" style="--qk-dujour-fond: {{ section.settings.couleur }};">
      {%- for p in section.settings.produits -%}
        {%- if p.available and p.featured_image -%}
          {%- assign v = p.selected_or_first_available_variant -%}
          {%- assign qk_t = p.title | split: ' — ' -%}
          {%- assign qk_nom = qk_t[0] | remove_first: p.vendor | strip -%}
          {%- if qk_nom == blank -%}{%- assign qk_nom = qk_t[0] -%}{%- endif -%}
          {%- assign qk_type = qk_t[1] | remove: ' pour femme' | remove: ' pour homme' | remove: ' mixte' | remove: ' voor dames' | remove: ' voor heren' | remove: ' unisex' | strip -%}
          <a class="qk-dujour__produit{% if forloop.index0 != qk_choix %} is-cache{% endif %}" data-qk-rang="{{ forloop.index0 }}" href="{{ v.url | default: p.url }}">
            <span class="qk-dujour__img">
              {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: p.title, widths: '300, 450, 600', sizes: '(min-width: 750px) 300px, 45vw' }}
            </span>
            <span class="qk-dujour__texte">
              <span class="qk-dujour__titre">{% if qk_nl %}Parfum van de dag{% else %}{{ section.settings.titre }}{% endif %}</span>
              <span class="qk-dujour__marque">{{ p.vendor }}</span>
              <span class="qk-dujour__ligne">{{ qk_nom }}</span>
              {%- if qk_type != blank -%}<span class="qk-dujour__ligne">{{ qk_type }}</span>{%- endif -%}
              {%- unless v.title == 'Default Title' -%}<span class="qk-dujour__ligne">{{ v.title }}</span>{%- endunless -%}
            </span>
            {%- assign qk_prix = v.price | money_without_currency | split: ',' -%}
            <span class="qk-dujour__prix" aria-label="{{ v.price | money }}">{{ qk_prix[0] }}{% if qk_prix[1] %},<sup>{{ qk_prix[1] }}</sup>{% endif %}<small> €</small></span>
          </a>
        {%- endif -%}
      {%- endfor -%}
      <div class="qk-dujour__compte" data-qk-compte>
        <span class="qk-dujour__compte-titre">{% if qk_nl %}Volgende parfum over{% else %}{{ section.settings.compte_texte }}{% endif %}</span>
        <span class="qk-dujour__cases">
          <span class="qk-dujour__case"><b data-qk-h>--</b><span>{% if qk_nl %}uur{% else %}heures{% endif %}</span></span>
          <span class="qk-dujour__case"><b data-qk-m>--</b><span>{% if qk_nl %}minuten{% else %}minutes{% endif %}</span></span>
          <span class="qk-dujour__case"><b data-qk-s>--</b><span>{% if qk_nl %}seconden{% else %}secondes{% endif %}</span></span>
        </span>
      </div>
    </div>
  </div>
  <script>
    (function () {
      var racine = document.getElementById('qk-dujour-{{ section.id }}');
      if (!racine) return;
      var produits = racine.querySelectorAll('.qk-dujour__produit');
      var n = produits.length, total = +racine.getAttribute('data-qk-total') || n;
      // heure de Bruxelles, quel que soit le fuseau du visiteur
      function bruxelles() {
        var parts = {};
        new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Brussels', year: 'numeric', month: '2-digit', day: '2-digit',
          hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' })
          .formatToParts(new Date()).forEach(function (x) { parts[x.type] = x.value; });
        return parts;
      }
      var actuel = -1;
      function deux(x) { return (x < 10 ? '0' : '') + x; }
      function tic() {
        var b = bruxelles();
        var jour = Math.floor(Date.UTC(+b.year, +b.month - 1, +b.day) / 86400000);
        var cible = jour % total, i = 0;
        for (var k = 0; k < n; k++) { if (+produits[k].getAttribute('data-qk-rang') >= cible) { i = k; break; } }
        if (i !== actuel) {
          for (k = 0; k < n; k++) produits[k].classList.toggle('is-cache', k !== i);
          actuel = i;
        }
        var reste = 86400 - (+b.hour * 3600 + +b.minute * 60 + +b.second);
        racine.querySelector('[data-qk-h]').textContent = deux(Math.floor(reste / 3600));
        racine.querySelector('[data-qk-m]').textContent = deux(Math.floor(reste % 3600 / 60));
        racine.querySelector('[data-qk-s]').textContent = deux(reste % 60);
      }
      tic();
      setInterval(tic, 1000);
    })();
  </script>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Qosmi · Parfum du jour",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "titre", "label": "Titre", "default": "Le parfum du jour" },
    { "type": "text", "id": "compte_texte", "label": "Texte au-dessus du compte à rebours", "default": "Prochain parfum dans" },
    { "type": "product_list", "id": "produits", "label": "Parfums possibles (un par jour, à tour de rôle)", "limit": 50 },
    { "type": "color", "id": "couleur", "label": "Couleur du bloc", "default": "#111111" }
  ],
  "presets": [{ "name": "Qosmi · Parfum du jour" }]
}
{% endschema %}
