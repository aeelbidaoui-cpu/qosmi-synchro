{%- comment -%}
  « Parfums aux notes proches » sur la fiche (12/11/2026) : 8 parfums en stock qui partagent le plus d'odeurs
  avec celui-ci (assets/qk-odeurs-outils.js). La section reste cachée si le parfum n'a pas de notes connues.
{%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}{%- assign qk_en = false -%}{%- if request.locale.iso_code == 'en' -%}{%- assign qk_en = true -%}{%- endif -%}
{%- comment -%} 26/11/2026 : si la fiche a son métachamp qosmi.proches (écrit par l'action « textes-fiches »), les parfums
  proches sont rendus côté serveur (visibles par Google) ; sinon, calcul dans le navigateur comme avant. {%- endcomment -%}
{%- assign qk_srv = product.metafields.qosmi.proches.value -%}
{%- assign qk_srv_n = 0 -%}<!-- qkp {{ product.metafields.qosmi.proches.type }}|{{ qk_srv.size }}|{{ product.metafields.qosmi.proches | json | slice: 0, 120 }} -->
{%- if qk_srv != blank -%}{%- for p in qk_srv -%}{%- if p.available and p.featured_image -%}{%- assign qk_srv_n = qk_srv_n | plus: 1 -%}{%- endif -%}{%- endfor -%}{%- endif -%}
<section class="qk-section qk-onglets qk-proches" data-qk-proches="{{ product.handle }}"{% if qk_srv_n >= 2 %} data-ok="1"{% else %} hidden{% endif %}>
  <div class="qk-largeur">
    <div class="qk-onglets__barre">
      <h2 class="qk-titre-section">{% if qk_nl %}Parfums met gelijkaardige noten{% elsif qk_en %}Fragrances with similar notes{% else %}Parfums aux notes proches{% endif %}</h2>
      <a class="qk-lien qk-onglets__tout" href="{{ routes.root_url | append: '/pages/odeurs' | replace: '//', '/' }}">{% if qk_nl %}Zoek op geur{% elsif qk_en %}Search by scent{% else %}Chercher par odeurs{% endif %}</a>
    </div>
  </div>
  <div class="qk-rangee" data-qk-proches-rangee>
    {%- if qk_srv_n >= 2 -%}{%- for p in qk_srv -%}{%- if p.available and p.featured_image -%}
      <div class="qk-rangee__item">{% render 'qk-carte', product: p %}</div>
    {%- endif -%}{%- endfor -%}{%- endif -%}
  </div>
  <script src="{{ 'qk-odeurs.js' | asset_url }}" defer></script>
  <script src="{{ 'qk-odeurs-outils.js' | asset_url }}" defer></script>
  <script>
    (function () {
      var nl = {{ qk_nl | json }}, en = {{ qk_en | json }};
      function demarrer() {
        var O = window.qkOdeurs, s = document.querySelector('[data-qk-proches]');
        if (!O || !s || s.getAttribute('data-ok')) return;
        s.setAttribute('data-ok', '1');
        var l = O.proches(s.getAttribute('data-qk-proches'));
        if (!l.length) return;
        var r = s.querySelector('[data-qk-proches-rangee]'), tmp = document.createElement('div');
        O.remplir(tmp, l, 0, 8, nl, 0).then(function () {
          if (tmp.children.length < 2) return;
          Array.prototype.slice.call(tmp.children).forEach(function (c) {
            var d = document.createElement('div'); d.className = 'qk-rangee__item'; d.appendChild(c); r.appendChild(d);
          });
          s.hidden = false;
          if (window.qkFavoris) qkFavoris.maj();
        });
      }
      if (window.qkOdeurs) demarrer(); else document.addEventListener('qk:odeurs', demarrer);
    })();
  </script>
</section>

{% schema %}
{ "name": "Qosmi · Notes proches", "tag": "div", "settings": [] }
{% endschema %}
