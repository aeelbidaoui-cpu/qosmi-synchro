{%- comment -%}
  Bandeau d'annonces qui défile en continu (demande d'Amine du 08/11/2026).
  Les messages sont dans le réglage « messages », un par ligne (scripts/theme_rk.py, liste ANNONCES).
{%- endcomment -%}
{%- assign qk_msgs = section.settings.messages | newline_to_br | split: '<br />' -%}
<div class="qk-annonces" role="region" aria-label="{{ 'Informations' }}">
  <div class="qk-annonces__piste" style="--qk-duree: {{ section.settings.duree }}s;">
    {%- for tour in (1..2) -%}
      <ul class="qk-annonces__liste"{% if tour == 2 %} aria-hidden="true"{% endif %}>
        {%- for m in qk_msgs -%}
          {%- assign t = m | strip -%}
          {%- if t != blank -%}<li class="qk-annonces__msg">{{ t }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endfor -%}
  </div>
</div>

{%- comment -%}
  Menu équilibré (12/11/2026, demande d'Amine) : sur ordinateur, « Trouve ton parfum », « Marques » et « Magazine »
  passent à droite du logo, le reste du menu reste à gauche. Le menu mobile garde tout (même menu « main-menu »).
{%- endcomment -%}
<nav class="qk-nav-droite" data-qk-nav-droite aria-label="{% if request.locale.iso_code == 'nl' %}Ontdekken{% else %}Découvrir{% endif %}" hidden>
  {%- for l in linklists['main-menu'].links -%}
    {%- if l.url contains '/pages/quiz' or l.url contains '/pages/marques' or l.url contains '/blogs/' -%}
      <a class="qk-nav-droite__lien{% if l.active or l.child_active %} is-actif{% endif %}" href="{{ l.url }}">{{ l.title }}</a>
    {%- endif -%}
  {%- endfor -%}
</nav>
<script>
  (function () {
    function placer() {
      var nav = document.querySelector('[data-qk-nav-droite]'), col = document.querySelector('.header__row--top .header__column--right');
      if (!nav || !col || nav.parentNode === col) return;
      col.insertBefore(nav, col.firstChild); nav.hidden = false;
      document.documentElement.classList.add('qk-menu-equilibre');
      if (window.matchMedia('(min-width: 990px)').matches) {
        document.querySelectorAll('header-menu .menu-list__list-item').forEach(function (li) {
          var a = li.querySelector('a.menu-list__link');
          if (a && /\/pages\/quiz|\/pages\/marques|\/blogs\//.test(a.getAttribute('href'))) li.remove();
        });
        window.dispatchEvent(new Event('resize'));
      }
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', placer); else placer();
  })();
</script>

{% schema %}
{
  "name": "Bandeau qui défile",
  "tag": "section",
  "class": "qk-annonces-section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "textarea", "id": "messages", "label": "Messages (un par ligne)" },
    { "type": "range", "id": "duree", "label": "Durée d'un tour (secondes)", "min": 10, "max": 90, "step": 5, "default": 45 }
  ],
  "presets": [{ "name": "Bandeau qui défile" }]
}
{% endschema %}
