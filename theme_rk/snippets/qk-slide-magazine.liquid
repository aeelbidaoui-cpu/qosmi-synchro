{%- comment -%} Diapositive « Magazine » (10/11/2026) : le dernier article publié, avec sa photo. {%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}
{%- assign qk_a = blogs['journal'].articles.first -%}
{%- if qk_a -%}
<div class="qk-hero qk-carrousel__slide qk-mag" role="group" aria-roledescription="{% if qk_nl %}dia{% else %}diapositive{% endif %}" aria-label="Magazine">
  <div class="qk-largeur qk-mag__cadre">
    <div class="qk-mag__col">
    <span class="qk-mag__sur">{% if qk_nl %}Het Magazine{% else %}Le Magazine{% endif %} · {{ qk_a.published_at | date: '%d/%m/%Y' }}</span>
    <h2 class="qk-mag__titre">{{ qk_a.title }}</h2>
    {%- assign qk_ex = qk_a.excerpt_or_content | strip_html | truncatewords: 26 -%}
    {%- if qk_ex != blank -%}<p class="qk-mag__texte">{{ qk_ex }}</p>{%- endif -%}
    <a class="qk-mag__bouton" href="{{ qk_a.url }}">{% if qk_nl %}Lees het artikel{% else %}Lire l'article{% endif %}</a>
    </div>
    {%- if qk_a.image -%}
    <a class="qk-mag__photo" href="{{ qk_a.url }}" tabindex="-1" aria-hidden="true">
      {{ qk_a.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 750px) 50vw, 100vw', widths: '600, 900, 1400', alt: qk_a.title }}
    </a>
    {%- endif -%}
  </div>
</div>
{%- endif -%}
