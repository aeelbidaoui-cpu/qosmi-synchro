{%- comment -%}
  Diapositive « Black Friday » (demande d'Amine du 10/11/2026, remise du 17/11/2026) : -10 % automatique au panier du 27 au
  30/11/2026 sur la collection black-friday (scripts/black_friday.py : fiches qui gardent au moins 5 € net). Annonce avant le
  27/11, « jusqu'à lundi » pendant. Visible jusqu'au 30/11/2026 inclus, puis disparaît toute seule.
{%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}
{%- assign qk_bf = collections['black-friday'] -%}
{%- assign qk_jour = 'now' | date: '%Y%m%d' | plus: 0 -%}
{%- if qk_bf and qk_bf.products_count > 0 and qk_jour <= 20261119 -%}
<div class="qk-hero qk-carrousel__slide qk-bf" role="group" aria-roledescription="{% if qk_nl %}dia{% else %}diapositive{% endif %}" aria-label="Black Friday">
  <span class="qk-bf__fond" aria-hidden="true">BLACK FRIDAY BLACK FRIDAY BLACK FRIDAY</span>
  <div class="qk-largeur qk-bf__cadre">
    <div class="qk-bf__texte">
      <span class="qk-bf__sur">{% if qk_jour < 20261127 %}{% if qk_nl %}Van vrijdag 27 tot maandag 30 november{% else %}Du vendredi 27 au lundi 30 novembre{% endif %}{% else %}{% if qk_nl %}Tot en met maandag 30 november{% else %}Jusqu'au lundi 30 novembre{% endif %}{% endif %}</span>
      <h2 class="qk-bf__titre">Black<br>Friday</h2>
      <p class="qk-bf__intro">{% if qk_nl %}-10 % op {{ qk_bf.products_count }} parfums, automatisch in je winkelmandje. Zonder code, 100 % origineel.{% else %}-10 % sur {{ qk_bf.products_count }} parfums, automatiquement au panier. Sans code, 100 % authentiques.{% endif %}</p>
      <a class="qk-bf__bouton" href="{{ qk_bf.url }}">{% if qk_nl %}Ontdek de selectie{% else %}Voir la sélection{% endif %}</a>
    </div>
    {%- comment -%} 20/11/2026 (Amine) : les parfums affichés tournent (qk-bf.js) : jusqu'à 24 fiches, 4 visibles à la fois (2 sur téléphone), tirées au hasard à chaque visite puis renouvelées toutes les 6 s. {%- endcomment -%}
    <div class="qk-bf__produits" data-qk-bf-rotation>
      {%- assign qk_n = 0 -%}
      {%- assign qk_vus = '|' -%}
      {%- for p in qk_bf.products limit: 250 -%}
        {%- assign qk_cle = '|' | append: p.vendor | append: '|' -%}
        {%- if qk_n < 24 and p.available and p.featured_image -%}{%- unless qk_vus contains qk_cle -%}
          {%- assign qk_n = qk_n | plus: 1 -%}
          {%- assign qk_vus = qk_vus | append: p.vendor | append: '|' -%}
          {%- assign qk_t = p.title | split: ' — ' -%}
          <a class="qk-bf__carte{% if qk_n > 4 %} qk-bf__carte--off{% endif %}" href="{{ p.url }}">
            <span class="qk-bf__img">{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: p.title, widths: '250, 400, 500', sizes: '(min-width: 750px) 14vw, 40vw' }}</span>
            <span class="qk-bf__marque">{{ p.vendor }}</span>
            <span class="qk-bf__nom">{{ qk_t[0] | remove_first: p.vendor | strip }}</span>
            <span class="qk-bf__prix">{% if p.price_varies %}{% if qk_nl %}vanaf{% else %}dès{% endif %} {% endif %}{{ p.price_min | money }} · -10 %</span>
          </a>
        {%- endunless -%}{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}
