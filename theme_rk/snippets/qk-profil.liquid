{%- comment -%}
  Profil du parfum sur la fiche (13/11/2026, demande d'Amine) : saison, tenue, sillage, occasions et pyramide des notes.
  Données : métachamp produit qosmi.profil (JSON), posé par scripts/fi_profils.py.
  { "s": ["automne","hiver"], "t": "journee", "si": "fort", "o": ["soiree","rdv"],
    "nf": {"t": [...], "c": [...], "f": [...]}, "nn": {...} }   (nf = notes FR, nn = notes NL)
  Rien ne s'affiche si le parfum n'a pas de profil.
{%- endcomment -%}
{%- assign p = product.metafields.qosmi.profil.value -%}
{%- if p -%}
{%- assign nl = false -%}{%- if request.locale.iso_code == 'nl' -%}{%- assign nl = true -%}{%- endif -%}{%- assign en = false -%}{%- if request.locale.iso_code == 'en' -%}{%- assign en = true -%}{%- endif -%}
<div class="qk-profil">
  {%- if p.s.size > 0 -%}
  <div class="qk-profil__ligne"><span class="qk-profil__k">{% if nl %}Seizoen{% elsif en %}Season{% else %}Saison{% endif %}</span><span class="qk-profil__v">
    {%- for x in p.s -%}{%- unless forloop.first %} · {% endunless -%}
      {%- case x -%}
        {%- when 'printemps' -%}{% if nl %}Lente{% elsif en %}Spring{% else %}Printemps{% endif %}
        {%- when 'ete' -%}{% if nl %}Zomer{% elsif en %}Summer{% else %}Été{% endif %}
        {%- when 'automne' -%}{% if nl %}Herfst{% elsif en %}Autumn{% else %}Automne{% endif %}
        {%- when 'hiver' -%}{% if nl %}Winter{% elsif en %}Winter{% else %}Hiver{% endif %}
      {%- endcase -%}
    {%- endfor -%}</span></div>
  {%- endif -%}
  {%- if p.t -%}
  <div class="qk-profil__ligne"><span class="qk-profil__k">{% if nl %}Houdbaarheid{% elsif en %}Longevity{% else %}Tenue{% endif %}</span><span class="qk-profil__v">
    {%- case p.t -%}
      {%- when 'legere' -%}{% if nl %}Licht{% elsif en %}Light{% else %}Légère{% endif %}
      {%- when 'moyenne' -%}{% if nl %}Gemiddeld{% elsif en %}Moderate{% else %}Moyenne{% endif %}
      {%- when 'longue' -%}{% if nl %}Lang{% elsif en %}Long{% else %}Longue{% endif %}
      {%- when 'journee' -%}{% if nl %}De hele dag{% elsif en %}All day{% else %}Toute la journée{% endif %}
      {%- when 'lendemain' -%}{% if nl %}Tot de volgende dag{% elsif en %}Until the next day{% else %}Jusqu'au lendemain{% endif %}
    {%- endcase -%}</span></div>
  {%- endif -%}
  {%- if p.si -%}
  <div class="qk-profil__ligne"><span class="qk-profil__k">Sillage</span><span class="qk-profil__v">
    {%- case p.si -%}
      {%- when 'discret' -%}{% if nl %}Subtiel{% elsif en %}Subtle{% else %}Discret{% endif %}
      {%- when 'modere' -%}{% if nl %}Gemiddeld{% elsif en %}Moderate{% else %}Modéré{% endif %}
      {%- when 'fort' -%}{% if nl %}Sterk{% elsif en %}Strong{% else %}Prononcé{% endif %}
      {%- when 'tres_fort' -%}{% if nl %}Zeer sterk{% elsif en %}Very strong{% else %}Très prononcé{% endif %}
    {%- endcase -%}</span></div>
  {%- endif -%}
  {%- if p.o.size > 0 -%}
  <div class="qk-profil__ligne qk-profil__ligne--occ"><span class="qk-profil__k">{% if nl %}Ideaal voor{% elsif en %}Ideal for{% else %}Idéal pour{% endif %}</span><span class="qk-profil__puces">
    {%- for x in p.o -%}<span class="qk-profil__puce">
      {%- case x -%}
        {%- when 'quotidien' -%}{% if nl %}Elke dag{% elsif en %}Every day{% else %}Tous les jours{% endif %}
        {%- when 'bureau' -%}{% if nl %}Kantoor{% elsif en %}Office{% else %}Bureau{% endif %}
        {%- when 'rdv' -%}{% if nl %}Een date{% elsif en %}A date{% else %}Rendez-vous{% endif %}
        {%- when 'diner' -%}{% if nl %}Etentje{% elsif en %}Dinner{% else %}Dîner{% endif %}
        {%- when 'soiree' -%}{% if nl %}Uitgaan{% elsif en %}Night out{% else %}Soirée{% endif %}
        {%- when 'mariage' -%}{% if nl %}Bruiloft{% elsif en %}Wedding{% else %}Mariage{% endif %}
        {%- when 'sport' -%}Sport
        {%- when 'vacances' -%}{% if nl %}Vakantie{% elsif en %}Holidays{% else %}Vacances{% endif %}
        {%- when 'chic' -%}{% if nl %}Chique gelegenheid{% elsif en %}Smart occasion{% else %}Événement chic{% endif %}
        {%- when 'detente' -%}{% if nl %}Ontspannen{% elsif en %}Relaxing{% else %}Détente{% endif %}
      {%- endcase -%}</span>{%- endfor -%}</span></div>
  {%- endif -%}
  {%- if nl -%}{%- assign ac = p.acn -%}{%- assign vb = p.vn -%}{%- elsif en and p.ace -%}{%- assign ac = p.ace -%}{%- assign vb = p.ve -%}{%- else -%}{%- assign ac = p.acf -%}{%- assign vb = p.vf -%}{%- endif -%}
  {%- if ac.size > 0 -%}
  <div class="qk-profil__ligne"><span class="qk-profil__k">{% if nl %}Geurfamilie{% elsif en %}Family{% else %}Famille{% endif %}</span><span class="qk-profil__v">{{ ac | join: ' · ' | capitalize | escape }}</span></div>
  {%- endif -%}
  {%- if vb.size > 0 -%}
  <div class="qk-profil__ligne"><span class="qk-profil__k">{% if nl %}Sfeer{% elsif en %}Mood{% else %}Ambiance{% endif %}</span><span class="qk-profil__v">{{ vb | join: ' · ' | capitalize | escape }}</span></div>
  {%- endif -%}
  {%- if p.a or p.pf.size > 0 -%}
  <div class="qk-profil__ligne"><span class="qk-profil__k">{% if p.pf.size > 0 %}{% if p.pf.size > 1 %}{% if nl %}Parfumeurs{% elsif en %}Perfumers{% else %}Parfumeurs{% endif %}{% else %}{% if en %}Perfumer{% else %}Parfumeur{% endif %}{% endif %}{% else %}{% if nl %}Uitgebracht{% elsif en %}Released{% else %}Sortie{% endif %}{% endif %}</span><span class="qk-profil__v">
    {%- if p.pf.size > 0 -%}{{ p.pf | join: ', ' | escape }}{%- if p.a %} · {{ p.a }}{% endif -%}{%- else -%}{{ p.a }}{%- endif -%}</span></div>
  {%- endif -%}
  {%- if nl -%}{%- assign n = p.nn -%}{%- elsif en and p.ne -%}{%- assign n = p.ne -%}{%- else -%}{%- assign n = p.nf -%}{%- endif -%}
  {%- if n and n.t.size > 0 or n.c.size > 0 or n.f.size > 0 or n.n.size > 0 -%}
  <div class="qk-profil__notes">
    {%- if n.t.size > 0 -%}<p><span class="qk-profil__k">{% if nl %}Topnoten{% elsif en %}Top{% else %}Tête{% endif %}</span>{{ n.t | join: ', ' | escape }}</p>{%- endif -%}
    {%- if n.c.size > 0 -%}<p><span class="qk-profil__k">{% if nl %}Hartnoten{% elsif en %}Heart{% else %}Cœur{% endif %}</span>{{ n.c | join: ', ' | escape }}</p>{%- endif -%}
    {%- if n.n.size > 0 -%}<p><span class="qk-profil__k">{% if nl %}Noten{% elsif en %}Notes{% else %}Notes{% endif %}</span>{{ n.n | join: ', ' | escape }}</p>{%- endif -%}
    {%- if n.f.size > 0 -%}<p><span class="qk-profil__k">{% if nl %}Basisnoten{% elsif en %}Base{% else %}Fond{% endif %}</span>{{ n.f | join: ', ' | escape }}</p>{%- endif -%}
  </div>
  {%- endif -%}
  {%- comment -%}24/11/2026 (SEO, liens internes) : collections par note dont le parfum fait partie (FR / NL / EN){%- endcomment -%}
  {%- assign qk_nc = 'parfums-vanille,vanille-parfums,vanilla-fragrances,parfums-oud,oud-parfums,oud-fragrances,parfums-cuir,leer-parfums,leather-fragrances,parfums-rose,rozenparfums,rose-fragrances,parfums-ambres,amberparfums,amber-fragrances,parfums-boises,houtige-parfums,woody-fragrances,parfums-gourmands,zoete-parfums,gourmand-fragrances,parfums-agrumes,citrusparfums,citrus-fragrances,parfums-musques,muskusparfums,musky-fragrances,parfums-epices,kruidige-parfums,spicy-fragrances,parfums-fleurs-blanches,witte-bloemen-parfums,white-floral-fragrances,parfums-tabac,tabaksparfums,tobacco-fragrances,parfums-iris,irisparfums,iris-fragrances,parfums-frais-marins,frisse-zeeparfums,fresh-marine-fragrances' | split: ',' -%}
  {%- capture qk_liens -%}{%- for c in product.collections -%}{%- if qk_nc contains c.handle -%}<a href="{{ c.url }}">{{ c.title | escape }}</a>{%- endif -%}{%- endfor -%}{%- endcapture -%}
  {%- if qk_liens != blank -%}
  <p class="qk-profil__collections"><span class="qk-profil__k">{% if nl %}Ontdek ook{% elsif en %}Explore{% else %}À explorer{% endif %}</span>{{ qk_liens | replace: '</a><a', '</a> · <a' }}</p>
  {%- endif -%}
  <p class="qk-profil__info">{% if nl %}Indicatief: houdbaarheid en sillage hangen af van je huid en het weer.{% elsif en %}For guidance only: longevity and sillage vary with your skin and the weather.{% else %}À titre indicatif : la tenue et le sillage varient selon la peau et la météo.{% endif %}</p>
</div>
{%- endif -%}
