{%- comment -%} Diapositive « Nouveautés » (10/11/2026) : les derniers parfums arrivés (collection nouveautes, triée par date d'ajout). {%- endcomment -%}
{%- assign qk_nl = false -%}
{%- if request.locale.iso_code == 'nl' -%}{%- assign qk_nl = true -%}{%- endif -%}
{%- assign qk_c = collections['nouveautes'] -%}
{%- if qk_c and qk_c.products_count > 0 -%}
<div class="qk-hero qk-carrousel__slide qk-neuf" role="group" aria-roledescription="{% if qk_nl %}dia{% else %}diapositive{% endif %}" aria-label="{% if qk_nl %}Nieuw{% else %}Nouveautés{% endif %}">
  <div class="qk-largeur qk-neuf__cadre">
    <div class="qk-neuf__texte">
      <span class="qk-neuf__sur">{% if qk_nl %}Net binnen{% else %}Tout juste arrivés{% endif %}</span>
      <h2 class="qk-neuf__titre">{% if qk_nl %}Nieuw{% else %}Nouveautés{% endif %}</h2>
      <a class="qk-neuf__bouton" href="{{ qk_c.url }}">{% if qk_nl %}Alles bekijken{% else %}Tout voir{% endif %}</a>
    </div>
    <div class="qk-neuf__etagere">
      {%- assign qk_n = 0 -%}
      {%- for p in qk_c.products limit: 30 -%}
        {%- if qk_n < 5 and p.available and p.featured_image -%}
          {%- assign qk_n = qk_n | plus: 1 -%}
          {%- assign qk_t = p.title | split: ' — ' -%}
          <a class="qk-neuf__carte" href="{{ p.url }}">
            <span class="qk-neuf__img">{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: p.title, widths: '250, 400, 500', sizes: '(min-width: 750px) 15vw, 45vw' }}</span>
            <span class="qk-neuf__marque">{{ p.vendor }}</span>
            <span class="qk-neuf__nom">{{ qk_t[0] | remove_first: p.vendor | strip }}</span>
            <span class="qk-neuf__prix">{{ p.price_min | money }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}
