{%- comment -%}
  Logo Qosmi en image (demande d'Amine 13/11/2026 : partout le logo, jamais « Qosmi » écrit en texte).
  {% render 'qk-logo', hauteur: 24, blanc: true %}  (blanc : sur fond sombre)
{%- endcomment -%}
{%- assign h = hauteur | default: 24 -%}
{%- assign w = h | times: 2144 | divided_by: 448 -%}
{%- assign h2 = h | times: 2 -%}
{%- if blanc -%}{%- assign f = 'qosmi-logo-blanc.png' -%}{%- else -%}{%- assign f = 'qosmi-logo.png' -%}{%- endif -%}
<img class="qk-logo {{ classe }}" src="{{ f | file_url }}&height={{ h2 }}" alt="Qosmi" width="{{ w }}" height="{{ h }}" loading="lazy">
