{%- comment -%} Qosmi · e-mail de bienvenue · « Nos parfums du moment » (12/11/2026) : fond crème, flacons dans des arches blanches. Les 4 premiers parfums disponibles de la liste. {%- endcomment -%}
{%- assign liste = 'maison-francis-kurkdjian-baccarat-rouge-540-eau-de-parfum-mixte,parfums-de-marly-layton-eau-de-parfum-mixte,parfums-de-marly-delina-eau-de-parfum-pour-femme,xerjoff-erba-pura-eau-de-parfum-mixte,maison-francis-kurkdjian-724-eau-de-parfum-mixte,initio-psychedelic-love-eau-de-parfum-mixte,versace-eros-eau-de-toilette-pour-homme,xerjoff-casamorati-1888-eau-de-parfum-mixte' | split: ',' -%}
{%- assign n = 0 -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F5EFE7;">
  <tr><td style="padding:36px 20px 10px;text-align:center;">
    <p style="margin:0 0 8px;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#8A7F72;">La sélection Qosmi</p>
    <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;color:#1A1A1A;">Nos parfums du moment</p>
  </td></tr>
  <tr><td style="padding:14px 12px 6px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
    {%- for h in liste -%}
      {%- assign p = all_products[h] -%}
      {%- if p and p.available and n < 4 -%}
        {%- if n == 2 -%}</tr><tr>{%- endif -%}
        {%- assign nom = p.title | split: ' — ' | first | remove_first: p.vendor | strip -%}
        {%- assign genre = p.title | split: ' — ' | last -%}
        <td width="50%" valign="top" style="padding:8px 8px 22px;">
          <a href="{{ shop.url }}/products/{{ p.handle }}" style="display:block;text-decoration:none;color:#1A1A1A;text-align:center;">
            <div style="background:#FFFFFF;border:1px solid #E7DCCD;border-radius:50% 50% 12px 12px / 30% 30% 12px 12px;overflow:hidden;padding:44px 16px 14px;">
              <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" width="150" style="display:block;margin:0 auto;width:100%;max-width:150px;height:auto;border:0;">
            </div>
            <p style="margin:14px 0 4px;font-family:Helvetica,Arial,sans-serif;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#8A7F72;">{{ p.vendor }}</p>
            <p style="margin:0 0 3px;font-family:Georgia,'Times New Roman',serif;font-size:16px;line-height:1.3;color:#1A1A1A;">{{ nom }}</p>
            <p style="margin:0 0 8px;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#8A7F72;">{{ genre }}</p>
            <p style="margin:0;font-family:Helvetica,Arial,sans-serif;font-size:14px;font-weight:600;color:#1A1A1A;">{{ p.price | money }}</p>
          </a>
        </td>
        {%- assign n = n | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    </tr></table>
  </td></tr>
  <tr><td style="padding:0 20px 38px;text-align:center;">
    <a href="{{ shop.url }}/collections/parfums" style="display:inline-block;padding:14px 30px;border:1px solid #1A1A1A;border-radius:999px;font-family:Helvetica,Arial,sans-serif;font-size:14px;color:#1A1A1A;text-decoration:none;">Voir tous nos parfums</a>
  </td></tr>
</table>
