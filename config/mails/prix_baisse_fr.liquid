{%- comment -%} Qosmi · e-mail « Un de tes favoris baisse de prix » (13/11/2026). Étiquettes prix-baisse:<fiche>:<ancien>:<nouveau> (centimes), posées par scripts/alertes_prix.py. {%- endcomment -%}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#F5EFE7;">
  <tr><td style="padding:36px 20px 10px;text-align:center;">
    <p style="margin:0 0 8px;font-family:Helvetica,Arial,sans-serif;font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#8A7F72;">Tes favoris</p>
    <p style="margin:0;font-family:Georgia,'Times New Roman',serif;font-size:26px;line-height:1.2;color:#1A1A1A;">Le prix a baissé</p>
  </td></tr>
  <tr><td style="padding:14px 12px 6px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
    {%- for t in customer.tags -%}
      {%- assign x = t | split: ':' -%}
      {%- if x[0] == 'prix-baisse' -%}
        {%- assign p = all_products[x[1]] -%}
        {%- if p and p.title != blank -%}
        {%- assign avant = x[2] | plus: 0 -%}{%- assign apres = x[3] | plus: 0 -%}
        {%- assign nom = p.title | split: ' — ' | first | remove_first: p.vendor | strip -%}
        <tr><td style="padding:8px 8px 18px;">
          <a href="{{ shop.url }}/products/{{ p.handle }}" style="display:block;text-decoration:none;color:#1A1A1A;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#FFFFFF;border:1px solid #E7DCCD;border-radius:14px;"><tr>
              <td width="130" style="padding:14px;"><img src="{{ p.featured_image | image_url: width: 300 }}" alt="{{ p.title | escape }}" width="110" style="display:block;width:110px;height:auto;border:0;"></td>
              <td style="padding:14px 16px 14px 4px;font-family:Helvetica,Arial,sans-serif;">
                <p style="margin:0 0 4px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#8A7F72;">{{ p.vendor }}</p>
                <p style="margin:0 0 10px;font-family:Georgia,'Times New Roman',serif;font-size:18px;line-height:1.3;color:#1A1A1A;">{{ nom }}</p>
                <p style="margin:0 0 12px;font-size:15px;"><span style="text-decoration:line-through;color:#8A7F72;">{{ avant | money }}</span>&nbsp;&nbsp;<strong style="color:#1A1A1A;">{{ apres | money }}</strong></p>
                <span style="display:inline-block;padding:10px 20px;background:#1A1A1A;border-radius:999px;font-size:13px;color:#FFFFFF;">Voir le parfum</span>
              </td>
            </tr></table>
          </a>
        </td></tr>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    </table>
  </td></tr>
  <tr><td style="padding:0 20px 38px;text-align:center;font-family:Helvetica,Arial,sans-serif;font-size:12px;color:#8A7F72;">Prix constaté sur qosmi.be au moment de l'envoi, susceptible de changer.</td></tr>
</table>
